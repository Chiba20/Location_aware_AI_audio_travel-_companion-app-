PORT=5000
DEBUG=True

# Premium confirmation email.
# Use real SMTP credentials from your email provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Optional: enables online AI story generation.
# Without this key, the app generates personalized stories from saved app content.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
