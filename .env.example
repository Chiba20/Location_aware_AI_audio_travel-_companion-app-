PORT=5000
DEBUG=True

# Premium confirmation email.
# Use real SMTP credentials from your email provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Admin-only premium driver route management and booking/location dashboard.
# Change this in production. Local fallback without this env var is admin123.
ADMIN_API_TOKEN=change-this-admin-token

# Optional token for driver apps/devices that send live GPS location updates.
# If unset, live location updates require the admin token.
DRIVER_LOCATION_TOKEN=change-this-driver-location-token

# Optional: enables AI generation for the Generate story button.
# Without this key, the server creates varied stories from saved place facts.
# Keep this server-side only. Never put this key in client/.env or frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
